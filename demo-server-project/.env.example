# CyberGuard gateway the demo server ships to
CYBERGUARD_GATEWAY_URL=http://localhost:8000/api/v1
CYBERGUARD_PROJECT_SLUG=your-project-slug

# Key: set exactly ONE of these (never committed, never logged)
# CYBERGUARD_MASTER_KEY=cg_org_...
# CYBERGUARD_KEY_FILE=/secure/path/gateway.key

# Traffic generator / service
SHIP_TIMEOUT_S=10
SHIP_MAX_RETRIES=3
DEMO_PORT=8020
STORE_PATH=data/responses.db
