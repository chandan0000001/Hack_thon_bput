# ==============================================================================
# CyberGuard Backend Environment Configuration
# ==============================================================================

# FastAPI Configuration
API_V1_PREFIX=/api/v1
PROJECT_NAME="CyberGuard AI SOAR"
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration (SQLAlchemy 2.0 Async)
# Default SQLite async local file (tests + local dev; no schema/RLS):
DATABASE_URL=sqlite+aiosqlite:///./cyberguard.db
# Or PostgreSQL asyncpg for production — use the cyberguard_api role
# (NOBYPASSRLS): every query is RLS-scoped by the app.user_id GUC.
# DATABASE_URL=postgresql+asyncpg://cyberguard_api:password@localhost:5432/cyberguard

# Service/postgres role — Alembic migrations, RLS verification (test_rls_pg.py),
# and pre-auth username lookups. Falls back to DATABASE_URL when empty.
MIGRATION_DATABASE_URL=

# Test Mode Database Switching (Optional)
# When TEST_MODE=true, DATABASE_URL and MIGRATION_DATABASE_URL automatically switch to test URLs
TEST_MODE=false
TEST_DATABASE_URL=sqlite+aiosqlite:///./cyberguard_test.db
TEST_MIGRATION_DATABASE_URL=sqlite+aiosqlite:///./cyberguard_test.db

# Organization accounts are frozen ("coming soon") until the Orgs Phase.
ORG_ENABLED=false

# Redis Broker Configuration (Required)
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/1

# ==============================================================================
# Email Connectors (Phase 1-2): Gmail only, via CYBERGUARD's own Google OAuth
# client. Supabase Google login is identity-only and is never used for Gmail.
# ==============================================================================

# Google Cloud OAuth Web Client (Gmail API enabled, consent screen in Test mode):
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/connectors/gmail/callback
# Where the OAuth callback redirects the browser afterwards:
FRONTEND_CONNECTORS_URL=http://localhost:5173/email-connectors

# Fernet key encrypting provider tokens at rest. Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTOR_TOKEN_KEY=
CONNECTOR_OAUTH_STATE_TTL_SECONDS=600
GMAIL_CONNECTOR_ENABLED=true

# Supabase Configuration (Authentication, RBAC & Cloud Storage)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=cyberguard-media

# Local Media Storage Fallback (used when Supabase storage is offline)
MEDIA_STORAGE_DIR=./uploads

# ==============================================================================
# Multi-Provider Distributed LLM Engine & Key Rotation
# Supports Groq, Gemini, and OpenRouter (OpenAI & Anthropic excluded by design)
# All keys are completely optional: missing keys log cleanly during startup and
# the system automatically operates in deterministic heuristic explanation mode.
# ==============================================================================

# Active providers to include in distributed round-robin pool:
LLM_PROVIDERS=groq,gemini,openrouter
LLM_COOLDOWN_SECONDS=60
LLM_HEALTH_CHECK_INTERVAL_SECONDS=30

# ------------------------------------------------------------------------------
# 1. Groq (Ultra-low latency inference: Llama 3.3 70B, Llama 3.1 8B, Mixtral)
# ------------------------------------------------------------------------------
GROQ_API_KEY=your-groq-api-key
# OR multiple keys (comma-separated or GROQ_API_KEY_1..N up to GROQ_MAX_KEYS):
# GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3
GROQ_MAX_KEYS=10
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

# ------------------------------------------------------------------------------
# 2. Google Gemini (Google GenAI: Gemini 2.0 Flash, Gemini 1.5 Flash)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
# OR multiple keys (comma-separated or GEMINI_API_KEY_1..N up to GEMINI_MAX_KEYS):
# GEMINI_API_KEYS=gemini_key1,gemini_key2
# Also supports standard GOOGLE_API_KEY
GEMINI_MAX_KEYS=10
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-1.5-flash

# ------------------------------------------------------------------------------
# 3. OpenRouter (Multi-model gateway)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=your-openrouter-api-key
# OR multiple keys:
# OPENROUTER_API_KEYS=sk-or-v1-key1,sk-or-v1-key2
OPENROUTER_MAX_KEYS=10
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
OPENROUTER_FALLBACK_MODELS=liquid/lfm-2.5-2.6b:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-lightning:free,nex-agi/nex-n2.5-mini:free

GMAIL_PUBSUB_TOPIC=projects/<your-project-name>/topics/cyberguard-gmail


# ==============================================================================
# Firecrawl Live Page Intelligence (OPTIONAL URL enrichment layer)
# Live scraping of public URLs to confirm brand lookalikes, credential-harvest
# forms, and redirect domain switches. Fully optional: with no API key the URL
# pipeline cleanly degrades to heuristics-only analysis (no errors, no extra
# latency) — see backend/docs/FIRECRAWL_INTEGRATION.md.
# Get a key at https://firecrawl.dev
# ==============================================================================
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
# Master switch; when false (or when FIRECRAWL_API_KEY is empty) enrichment is skipped.
FIRECRAWL_ENABLED=true
# Hard per-scrape timeout; total added latency per URL analysis is bounded by this.
FIRECRAWL_TIMEOUT_SECONDS=10
# Redis cache TTL for scraped pages (sha256(url) keyed).
FIRECRAWL_CACHE_TTL_SECONDS=3600
# Max concurrent outbound scrapes (asyncio.Semaphore).
FIRECRAWL_MAX_CONCURRENCY=4
# PRIVACY GUARD: internal/local hosts (.local, RFC1918, single-label, ...) are
# classified but never crawled — internal URLs must never leave the platform.
FIRECRAWL_SKIP_INTERNAL_URLS=true
